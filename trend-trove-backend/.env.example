# Server Configuration
PORT=9090
NODE_ENV=development
SESSION_SECRET=trendrove_session_secret_key_change_in_production

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/trendrove

# Authentication / Security
JWT_SECRET=1921u0030
FRONTEND_URL=http://localhost:3005

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudinary Credentials (For Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / Nodemailer Configuration (For OTPs & Order Emails)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Razorpay Credentials (For Payment Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
